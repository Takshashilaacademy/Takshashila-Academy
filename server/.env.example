# Takshashila Academy Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/takshashila-academy

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=takshashila-academy
JWT_AUDIENCE=takshashila-students

# Frontend CORS
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=0

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Initial admin creation (used only by scripts/createAdmin.js)
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=

# Password reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
